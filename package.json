{
  "name": "@testframe/tour-ui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "TestFrame test-tour UI: the tour screens, the browser tour state (IndexedDB) and the PDF report. One React implementation, compiled from source by the IDE and built statically into the plugin jar (served at /tour).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun scripts/sync-plugin.ts",
    "fonts": "bun scripts/generate-fonts.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.4",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "subset-font": "^2.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
